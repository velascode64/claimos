# Required for `bun run flow:live`
THE_GRAPH_API_KEY=
ALCHEMY_API_KEY=

# Optional: Merkl works without a key at its public rate limit.
MERKL_API_KEY=

# Reserved for the Bazantic workflow adapter once its endpoint/recipe ID is configured.
BAZANTIC_API_KEY=

# Override only when using another official Token API gateway.
CLAIMOS_GRAPH_API_URL=https://token-api.thegraph.com

# Comma-separated The Graph network identifiers.
CLAIMOS_GRAPH_NETWORKS=mainnet,base,arbitrum-one,optimism
